local function AddTab(name, iconRect, isCategory)
	if isCategory then
		create("TextLabel", {Text = name, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Color3.fromRGB(80, 80, 80), Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Parent = Sidebar})
		return
	end

	local Page = create("ScrollingFrame", {
		Name = name.."Page", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, ScrollBarThickness = 2,
		ScrollBarImageColor3 = THEME.Accent, BorderSizePixel = 0, CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, Parent = ContentRegion
	})
	RegisterAccent(Page, "ScrollBarImageColor3")
	create("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = Page})
	create("UIPadding", {PaddingTop = UDim.new(0, 15), PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 15), PaddingBottom = UDim.new(0, 15), Parent = Page})
	Pages[name] = Page

	local Btn = create("TextButton", {Name = name, Size = UDim2.new(1, -20, 0, 35), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = Sidebar})
	local BtnBG = create("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(30, 30, 30), BackgroundTransparency = 1, Parent = Btn})
	makeCorner(4, BtnBG)
	local Icon = create("ImageLabel", {
		Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(0, 6, 0.5, -9), BackgroundTransparency = 1,
		Image = "rbxassetid://3926305904", ImageRectSize = Vector2.new(36, 36), ImageRectOffset = iconRect or Vector2.new(0,0), ImageColor3 = THEME.SubText, Parent = Btn
	})
	local Label = create("TextLabel", {
		Text = name, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = THEME.SubText, Size = UDim2.new(1, -30, 1, 0),
		Position = UDim2.new(0, 32, 0, 0), BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Parent = Btn
	})

	Tabs[name] = {Btn = Btn, BG = BtnBG, Icon = Icon, Label = Label}

	Btn.MouseButton1Click:Connect(function()
		-- CLOSE ANY OPEN DROPDOWN WHEN SWITCHING TABS
		if ActiveDropdownCloseFunc then 
			ActiveDropdownCloseFunc() 
			ActiveDropdownCloseFunc = nil
		end

		if CurrentPage == name then return end
		if CurrentPage and Tabs[CurrentPage] then
			tween(Tabs[CurrentPage].BG, {BackgroundTransparency = 1})
			tween(Tabs[CurrentPage].Icon, {ImageColor3 = THEME.SubText})
			tween(Tabs[CurrentPage].Label, {TextColor3 = THEME.SubText})
			Pages[CurrentPage].Visible = false
		end
		CurrentPage = name
		tween(BtnBG, {BackgroundTransparency = 0.5})
		tween(Icon, {ImageColor3 = THEME.Accent})
		tween(Label, {TextColor3 = THEME.Text})
		Page.Visible = true
		Page.Position = UDim2.new(0, 15, 0, 0)
		tween(Page, {Position = UDim2.new(0,0,0,0)})
	end)
end

