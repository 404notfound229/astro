local AstroUI = {}
AstroUI.__index = AstroUI

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")


local THEME = {
    Background = Color3.fromRGB(15, 15, 15),
    Sidebar    = Color3.fromRGB(15, 15, 15),
    Text       = Color3.fromRGB(240, 240, 240),
    SubText    = Color3.fromRGB(140, 140, 140),
    Accent     = Color3.fromRGB(0, 255, 255),
    Divider    = Color3.fromRGB(40, 40, 40),
    ItemBG     = Color3.fromRGB(22, 22, 22),
    ToggleOff  = Color3.fromRGB(45, 45, 45),
    Hover      = Color3.fromRGB(35, 35, 35)
}

local AccentRegistry = {}
local SearchRegistry = {}
local ActiveDropdownCloseFunc = nil

local function getParent()
    local success, result = pcall(function() return CoreGui end)
    if success and result then return result end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function create(className, props, children)
    local inst = Instance.new(className)
    for i, v in pairs(props or {}) do inst[i] = v end
    if children then for _, child in pairs(children) do child.Parent = inst end end
    return inst
end

local function makeCorner(radius, parent)
    return create("UICorner", {CornerRadius = UDim.new(0, radius), Parent = parent})
end

local function tween(obj, props, duration)
    TweenService:Create(obj, TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props):Play()
end

local function RegisterAccent(obj, property)
    table.insert(AccentRegistry, {Object = obj, Property = property})
    obj[property] = THEME.Accent
end

local function UpdateTheme(newColor)
    THEME.Accent = newColor
    for _, data in pairs(AccentRegistry) do
        if data.Object then
            TweenService:Create(data.Object, TweenInfo.new(0.3), {[data.Property] = newColor}):Play()
        end
    end
end

for _, v in pairs(getParent():GetChildren()) do
    if v.Name == "AstroUI" then v:Destroy() end
end



local Window = {}
Window.__index = Window

function AstroUI:CreateWindow(config)
    config = config or {}
    local self = setmetatable({}, Window)
    
    self.Title = config.Title or "ASTRO"
    self.Size = config.Size or UDim2.new(0, 650, 0, 450)
    self.Tabs = {}
    self.Pages = {}
    self.CurrentPage = nil
    
    self.ScreenGui = create("ScreenGui", {
        Name = "AstroUI",
        Parent = getParent(),
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        ResetOnSpawn = false
    })
    
     
    self.MainFrame = create("Frame", {
        Name = "MainFrame",
        Size = self.Size,
        Position = UDim2.new(0.5, -self.Size.X.Offset/2, 0.5, -self.Size.Y.Offset/2),
        BackgroundColor3 = THEME.Background,
        BorderSizePixel = 0,
        Parent = self.ScreenGui,
        ClipsDescendants = true
    })
    makeCorner(6, self.MainFrame)
    
    self.DropdownLayer = create("Frame", {
        Name = "DropdownLayer", Size = UDim2.new(1, 0, 1, 0), 
        BackgroundTransparency = 1, Parent = self.MainFrame, ZIndex = 100
    })
    
    self:_createHeader()
    
    self:_createBody()
    
    return self
end

function Window:_createHeader()
    local Header = create("Frame", {
        Name = "Header", Size = UDim2.new(1, 0, 0, 50), 
        BackgroundTransparency = 1, Parent = self.MainFrame, ZIndex = 10
    })
    
    local dragging, dragInput, dragStart, startPos
    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = self.MainFrame.Position
            input.Changed:Connect(function() 
                if input.UserInputState == Enum.UserInputState.End then dragging = false end 
            end)
        end
    end)
    Header.InputChanged:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end 
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            self.MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    local Title = create("TextLabel", {
        Text = self.Title, Font = Enum.Font.GothamBold, TextSize = 22, TextColor3 = THEME.Accent,
        Size = UDim2.new(0, 150, 1, 0), Position = UDim2.new(0, 20, 0, 0), BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = Header
    })
    RegisterAccent(Title, "TextColor3")
    
    local SearchFrame = create("Frame", {
        Size = UDim2.new(0, 200, 0, 28), Position = UDim2.new(1, -210, 0.5, -14), 
        BackgroundTransparency = 1, Parent = Header
    })
    create("ImageLabel", {
        Image = "rbxassetid://3926305904", ImageRectOffset = Vector2.new(964, 324), ImageRectSize = Vector2.new(36, 36),
        Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(1, -22, 0.5, -9), BackgroundTransparency = 1,
        ImageColor3 = Color3.fromRGB(120, 120, 120), Parent = SearchFrame
    })
    local SearchBox = create("TextBox", {
        Text = "Search", TextColor3 = Color3.fromRGB(120, 120, 120), TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.Gotham, TextSize = 14, BackgroundTransparency = 1, Size = UDim2.new(1, -30, 1, 0), Parent = SearchFrame
    })
    
    SearchBox.Focused:Connect(function() 
        if SearchBox.Text == "Search" then SearchBox.Text = "" end 
        SearchBox.TextColor3 = THEME.Text 
    end)
    SearchBox.FocusLost:Connect(function() 
        if SearchBox.Text == "" then SearchBox.Text = "Search" SearchBox.TextColor3 = Color3.fromRGB(120, 120, 120) end 
    end)
    SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local query = SearchBox.Text:lower()
        if query == "search" then return end
        for _, item in ipairs(SearchRegistry) do
            item.Frame.Visible = (query == "" or string.find(item.Text:lower(), query))
        end
    end)
    
    local Divider = create("Frame", {
        Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 0, 50), 
        BackgroundColor3 = THEME.Accent, BorderSizePixel = 0, Parent = self.MainFrame, ZIndex = 5
    })
    RegisterAccent(Divider, "BackgroundColor3")
    create("UIGradient", {Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.8)}), Parent = Divider})
end

