local Library = {}
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local THEME = {
	Background = Color3.fromRGB(15, 15, 15), Sidebar = Color3.fromRGB(15, 15, 15),
	Text = Color3.fromRGB(240, 240, 240), SubText = Color3.fromRGB(140, 140, 140),
	Accent = Color3.fromRGB(0, 255, 255), Divider = Color3.fromRGB(40, 40, 40),
	ItemBG = Color3.fromRGB(22, 22, 22), ToggleOff = Color3.fromRGB(45, 45, 45), Hover = Color3.fromRGB(35, 35, 35)
}

local AccentRegistry, SearchRegistry, ActiveDropdownCloseFunc = {}, {}, nil 

local function RegisterAccent(obj, property)
	table.insert(AccentRegistry, {Object = obj, Property = property})
	obj[property] = THEME.Accent
end

local function UpdateTheme(newColor)
	THEME.Accent = newColor
	for _, data in pairs(AccentRegistry) do
		if data.Object then TweenService:Create(data.Object, TweenInfo.new(0.3), {[data.Property] = newColor}):Play() end
	end
end

local function getParent()
	local success, result = pcall(function() return CoreGui end)
	return (success and result) or Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function create(className, props)
	local inst = Instance.new(className)
	for i, v in pairs(props or {}) do inst[i] = v end
	return inst
end

local function makeCorner(radius, parent)
	local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, radius) c.Parent = parent
end

local function tween(obj, props)
	TweenService:Create(obj, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props):Play()
end

function Library:CreateWindow()
	for _, v in pairs(getParent():GetChildren()) do if v.Name == "AstroUI_Lib" then v:Destroy() end end

	local ScreenGui = create("ScreenGui", {Name = "AstroUI_Lib", Parent = getParent(), ZIndexBehavior = Enum.ZIndexBehavior.Sibling, ResetOnSpawn = false})
	local MainFrame = create("Frame", {Name = "MainFrame", Size = UDim2.new(0, 650, 0, 450), Position = UDim2.new(0.5, -325, 0.5, -225), BackgroundColor3 = THEME.Background, BorderSizePixel = 0, Parent = ScreenGui, ClipsDescendants = true})
	makeCorner(6, MainFrame)
	local DropdownLayer = create("Frame", {Name = "DropdownLayer", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Parent = MainFrame, ZIndex = 100})
	local Header = create("Frame", {Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, Parent = MainFrame, ZIndex = 10})

	local dragging, dragInput, dragStart, startPos
	Header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging, dragStart, startPos = true, input.Position, MainFrame.Position
			input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
		end
	end)
	Header.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end end)
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)

	local Title = create("TextLabel", {Text = "ASTRO", Font = Enum.Font.GothamBold, TextSize = 22, TextColor3 = THEME.Accent, Size = UDim2.new(0, 150, 1, 0), Position = UDim2.new(0, 20, 0, 0), BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Parent = Header})
	RegisterAccent(Title, "TextColor3")

	local SearchFrame = create("Frame", {Size = UDim2.new(0, 200, 0, 28), Position = UDim2.new(1, -210, 0.5, -14), BackgroundTransparency = 1, Parent = Header})
	local SearchBox = create("TextBox", {Text = "Search", TextColor3 = Color3.fromRGB(120, 120, 120), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.Gotham, TextSize = 14, BackgroundTransparency = 1, Size = UDim2.new(1, -30, 1, 0), Parent = SearchFrame})
	SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
		local query = SearchBox.Text:lower()
		for _, item in ipairs(SearchRegistry) do item.Frame.Visible = (query == "" or query == "search" or string.find(item.Text:lower(), query)) end
	end)

	local Divider = create("Frame", {Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 0, 50), BackgroundColor3 = THEME.Accent, BorderSizePixel = 0, Parent = MainFrame, ZIndex = 5})
	RegisterAccent(Divider, "BackgroundColor3")

	local Body = create("Frame", {Size = UDim2.new(1, 0, 1, -51), Position = UDim2.new(0, 0, 0, 51), BackgroundTransparency = 1, Parent = MainFrame})
	local Sidebar = create("Frame", {Size = UDim2.new(0, 160, 1, 0), BackgroundTransparency = 1, Parent = Body})
	create("UIListLayout", {Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder, Parent = Sidebar})
	create("UIPadding", {PaddingTop = UDim.new(0, 15), PaddingLeft = UDim.new(0, 10), Parent = Sidebar})
	local ContentRegion = create("Frame", {Size = UDim2.new(1, -170, 1, 0), Position = UDim2.new(0, 170, 0, 0), BackgroundTransparency = 1, Parent = Body})

	local WindowObj, CurrentPage = {}, nil

	function WindowObj:Tab(name, iconRect)
		if name == "Settings" or name == "Categories" then
             create("TextLabel", {Text = name, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Color3.fromRGB(80, 80, 80), Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Parent = Sidebar})
             return
        end
		local Page = create("ScrollingFrame", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, ScrollBarThickness = 2, BorderSizePixel = 0, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, Parent = ContentRegion})
		RegisterAccent(Page, "ScrollBarImageColor3")
		create("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = Page})
		create("UIPadding", {PaddingTop = UDim.new(0, 15), PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 15), PaddingBottom = UDim.new(0, 15), Parent = Page})

		local Btn = create("TextButton", {Size = UDim2.new(1, -20, 0, 35), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = Sidebar})
		local BtnBG = create("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(30, 30, 30), BackgroundTransparency = 1, Parent = Btn})
		makeCorner(4, BtnBG)
		local Icon = iconRect and create("ImageLabel", {Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(0, 6, 0.5, -9), BackgroundTransparency = 1, Image = "rbxassetid://3926305904", ImageRectSize = Vector2.new(36, 36), ImageRectOffset = iconRect, ImageColor3 = THEME.SubText, Parent = Btn})
		local Label = create("TextLabel", {Text = name, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = THEME.SubText, Size = UDim2.new(1, -30, 1, 0), Position = UDim2.new(0, iconRect and 32 or 10, 0, 0), BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Parent = Btn})

		Btn.MouseButton1Click:Connect(function()
			if ActiveDropdownCloseFunc then ActiveDropdownCloseFunc() end
			if CurrentPage == name then return end
			if CurrentPage then tween(CurrentPage.BG, {BackgroundTransparency = 1}) if CurrentPage.Icon then tween(CurrentPage.Icon, {ImageColor3 = THEME.SubText}) end tween(CurrentPage.Label, {TextColor3 = THEME.SubText}) CurrentPage.Page.Visible = false end
			CurrentPage = {BG = BtnBG, Icon = Icon, Label = Label, Page = Page}
			tween(BtnBG, {BackgroundTransparency = 0.5}) if Icon then tween(Icon, {ImageColor3 = THEME.Accent}) end tween(Label, {TextColor3 = THEME.Text})
			Page.Visible = true
		end)

		local TabFuncs = {}
		function TabFuncs:Toggle(text, default, callback)
			local h = create("Frame", {Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Parent = Page})
			table.insert(SearchRegistry, {Frame = h, Text = text})
			create("TextLabel", {Text = text, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = THEME.Text, Size = UDim2.new(1, -50, 1, 0), BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Parent = h})
			local b = create("TextButton", {Text = "", Size = UDim2.new(0, 32, 0, 18), Position = UDim2.new(1, -35, 0.5, -9), BackgroundColor3 = default and THEME.Accent or THEME.ToggleOff, Parent = h})
			makeCorner(9, b) if default then RegisterAccent(b, "BackgroundColor3") end
			local c = create("Frame", {Size = UDim2.new(0, 14, 0, 14), Position = default and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7), BackgroundColor3 = Color3.new(1,1,1), Parent = b})
			makeCorner(7, c)
			local on = default b.MouseButton1Click:Connect(function() on = not on tween(b, {BackgroundColor3 = on and THEME.Accent or THEME.ToggleOff}) tween(c, {Position = on and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)}) callback(on) end)
		end
		function TabFuncs:Dropdown(text, options, default, callback)
			local h = create("Frame", {Size = UDim2.new(1, 0, 0, 45), BackgroundTransparency = 1, Parent = Page})
			table.insert(SearchRegistry, {Frame = h, Text = text})
			local mb = create("TextButton", {Text = "", Size = UDim2.new(0, 140, 0, 26), Position = UDim2.new(1, -145, 0.5, -13), BackgroundColor3 = THEME.ItemBG, Parent = h})
			makeCorner(4, mb)
			local st = create("TextLabel", {Text = default, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = THEME.Text, Size = UDim2.new(1, -30, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Parent = mb})
			local lc = create("Frame", {Size = UDim2.new(0, 140, 0, 0), BackgroundColor3 = THEME.ItemBG, BorderSizePixel = 0, ClipsDescendants = true, Visible = false, Parent = DropdownLayer})
			makeCorner(4, lc) create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Parent = lc})
			local open = false local function close() open = false tween(lc, {Size = UDim2.new(0, 140, 0, 0)}) task.wait(0.2) lc.Visible = false end
			mb.MouseButton1Click:Connect(function() if open then close() else if ActiveDropdownCloseFunc then ActiveDropdownCloseFunc() end open = true ActiveDropdownCloseFunc = close lc.Visible = true tween(lc, {Size = UDim2.new(0, 140, 0, #options * 24 + 8)}) RunService.RenderStepped:Connect(function() if open then local p = mb.AbsolutePosition - DropdownLayer.AbsolutePosition lc.Position = UDim2.new(0, p.X, 0, p.Y + 30) end end) end end)
			for _, o in ipairs(options) do local ob = create("TextButton", {Text = "  "..o, Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, TextColor3 = THEME.SubText, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = lc}) ob.MouseButton1Click:Connect(function() st.Text = o close() callback(o) end) end
		end
		function TabFuncs:Slider(text, min, max, default, callback)
			local h = create("Frame", {Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, Parent = Page})
			table.insert(SearchRegistry, {Frame = h, Text = text})
			local vl = create("TextLabel", {Text = tostring(default), Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = THEME.Accent, Size = UDim2.new(0, 40, 0, 20), Position = UDim2.new(1, -40, 0, 0), BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Right, Parent = h}) RegisterAccent(vl, "TextColor3")
			local sb = create("Frame", {Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 0, 30), BackgroundColor3 = THEME.ItemBG, Parent = h}) makeCorner(2, sb)
			local fl = create("Frame", {Size = UDim2.new((default-min)/(max-min), 0, 1, 0), BackgroundColor3 = THEME.Accent, Parent = sb}) makeCorner(2, fl) RegisterAccent(fl, "BackgroundColor3")
			local it = create("TextButton", {Text = "", Size = UDim2.new(1, 0, 1, 10), Position = UDim2.new(0, 0, 0, -5), BackgroundTransparency = 1, Parent = sb})
			local drag = false it.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true end end) UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end end)
			UserInputService.InputChanged:Connect(function(i) if drag and i.UserInputType == Enum.UserInputType.MouseMovement then local p = math.clamp((UserInputService:GetMouseLocation().X - sb.AbsolutePosition.X) / sb.AbsoluteSize.X, 0, 1) fl.Size = UDim2.new(p, 0, 1, 0) local v = math.floor(min + (max-min)*p) vl.Text = tostring(v) callback(v) end end)
		end
		function TabFuncs:ColorPicker()
			local h = create("Frame", {Size = UDim2.new(1, 0, 0, 160), BackgroundTransparency = 1, Parent = Page})
			local SV = create("Frame", {Size = UDim2.new(0, 140, 0, 120), Position = UDim2.new(0, 0, 0, 30), BackgroundColor3 = Color3.new(1,0,0), Parent = h})
			local hue = create("Frame", {Size = UDim2.new(0, 20, 0, 120), Position = UDim2.new(0, 150, 0, 30), Parent = h})
			create("UIGradient", {Rotation=90, Color=ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0,255,255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255,0,0))}), Parent=hue})
			local hv, sv, vv = 0.5, 1, 1
			local function up() SV.BackgroundColor3 = Color3.fromHSV(hv,1,1) UpdateTheme(Color3.fromHSV(hv,sv,vv)) end
			hue.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then local c c = RunService.RenderStepped:Connect(function() local y = math.clamp((UserInputService:GetMouseLocation().Y - hue.AbsolutePosition.Y)/hue.AbsoluteSize.Y, 0, 1) hv = 1-y up() if not UserInputService:IsMouseButtonPressed(Enum.MouseButton1) then c:Disconnect() end end) end end)
			up()
		end
		function TabFuncs:Keybind(text, default, callback)
			local h = create("Frame", {Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Parent = Page})
			local kb = create("TextButton", {Text = "["..default.Name.."]", Size = UDim2.new(0, 100, 0, 24), Position = UDim2.new(1, -105, 0.5, -12), BackgroundColor3 = THEME.ItemBG, TextColor3 = THEME.SubText, Font = Enum.Font.Gotham, TextSize = 13, Parent = h}) makeCorner(4, kb)
			local cur = default UserInputService.InputBegan:Connect(function(i) if i.KeyCode == cur then ScreenGui.Enabled = not ScreenGui.Enabled end end)
		end
		return TabFuncs
	end
	return WindowObj
end

return Library
