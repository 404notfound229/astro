local function CreateSection(parent, height)
	return create("Frame", {Size = UDim2.new(1, 0, 0, height or 40), BackgroundTransparency = 1, Parent = parent})
end
local function CreateLabel(parent, text)
	return create("TextLabel", {Text = text, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = THEME.SubText, Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Parent = parent})
end

-- 1. Toggle
local function AddToggle(parent, text, default, callback)
	local holder = CreateSection(parent, 30)
	table.insert(SearchRegistry, {Frame = holder, Text = text})
	
	local label = CreateLabel(holder, text)
	label.Size = UDim2.new(1, -50, 1, 0)
	label.TextColor3 = THEME.Text

	local button = create("TextButton", {
		Text = "", Size = UDim2.new(0, 32, 0, 18), Position = UDim2.new(1, -35, 0.5, -9),
		BackgroundColor3 = default and THEME.Accent or THEME.ToggleOff, AutoButtonColor = false, Parent = holder
	})
	makeCorner(9, button)
	if default then RegisterAccent(button, "BackgroundColor3") end

	local circle = create("Frame", {
		Size = UDim2.new(0, 14, 0, 14), Position = default and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
		BackgroundColor3 = Color3.new(1,1,1), Parent = button
	})
	makeCorner(7, circle)

	local on = default
	button.MouseButton1Click:Connect(function()
		on = not on
		if on then
			RegisterAccent(button, "BackgroundColor3")
			tween(button, {BackgroundColor3 = THEME.Accent})
			tween(circle, {Position = UDim2.new(1, -16, 0.5, -7)})
		else
			tween(button, {BackgroundColor3 = THEME.ToggleOff})
			tween(circle, {Position = UDim2.new(0, 2, 0.5, -7)})
		end
		if callback then callback(on) end
	end)
end

-- 2. Dropdown (FLOATING + AUTO CLOSE LOGIC)
local function AddDropdown(parent, text, options, default, callback)
	local holder = CreateSection(parent, 45)
	table.insert(SearchRegistry, {Frame = holder, Text = text})
	
	local label = CreateLabel(holder, text)
	label.Size = UDim2.new(0, 100, 1, 0)
	
	local mainBtn = create("TextButton", {
		Text = "", Size = UDim2.new(0, 140, 0, 26), Position = UDim2.new(1, -145, 0.5, -13),
		BackgroundColor3 = THEME.ItemBG, AutoButtonColor = false, Parent = holder
	})
	makeCorner(4, mainBtn)
	
	local selectedText = create("TextLabel", {
		Text = default, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = THEME.Text,
		Size = UDim2.new(1, -30, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = mainBtn
	})
	
	local arrow = create("ImageLabel", {
		Image = "rbxassetid://6034818372", Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(1, -20, 0.5, -6),
		BackgroundTransparency = 1, ImageColor3 = THEME.SubText, Parent = mainBtn
	})

	local listContainer = create("Frame", {
		Size = UDim2.new(0, 140, 0, 0), BackgroundColor3 = THEME.ItemBG, 
		BorderSizePixel = 0, ClipsDescendants = true, Visible = false, Parent = DropdownLayer
	})
	makeCorner(4, listContainer)
	create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2), Parent = listContainer})
	create("UIPadding", {PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = listContainer})

	local isOpen = false
	local renderStep

	local function closeDropdown()
		isOpen = false
		if renderStep then renderStep:Disconnect() renderStep = nil end
		tween(arrow, {Rotation = 0})
		tween(listContainer, {Size = UDim2.new(0, 140, 0, 0)})
		task.wait(0.25)
		if not isOpen then listContainer.Visible = false end
		
		-- Clear global ref if it was us
		if ActiveDropdownCloseFunc == closeDropdown then
			ActiveDropdownCloseFunc = nil
		end
	end

	mainBtn.MouseButton1Click:Connect(function()
		if isOpen then
			closeDropdown()
		else
			-- Close other dropdowns first
			if ActiveDropdownCloseFunc then ActiveDropdownCloseFunc() end
			
			isOpen = true
			ActiveDropdownCloseFunc = closeDropdown -- Register self
			
			listContainer.Visible = true
			tween(arrow, {Rotation = 180})
			tween(listContainer, {Size = UDim2.new(0, 140, 0, math.min(#options * 24 + 10, 150))})
			renderStep = RunService.RenderStepped:Connect(function()
				if not mainBtn or not mainBtn.Parent then closeDropdown() return end
				local btnAbsPos = mainBtn.AbsolutePosition
				local layerAbsPos = DropdownLayer.AbsolutePosition
				listContainer.Position = UDim2.new(0, btnAbsPos.X - layerAbsPos.X, 0, (btnAbsPos.Y - layerAbsPos.Y) + 30)
			end)
		end
	end)

	for _, opt in ipairs(options) do
		local optBtn = create("TextButton", {
			Text = "  " .. opt, Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1,
			TextColor3 = THEME.SubText, Font = Enum.Font.Gotham, TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 110, Parent = listContainer
		})
		optBtn.MouseButton1Click:Connect(function()
			selectedText.Text = opt
			closeDropdown()
			if callback then callback(opt) end
		end)
		optBtn.MouseEnter:Connect(function() 
			optBtn.BackgroundColor3 = THEME.Accent 
			optBtn.BackgroundTransparency = 0.85
		end)
		optBtn.MouseLeave:Connect(function() 
			optBtn.BackgroundTransparency = 1
		end)
	end
end

-- 3. Slider
local function AddSlider(parent, text, min, max, default, callback)
	local holder = CreateSection(parent, 50)
	table.insert(SearchRegistry, {Frame = holder, Text = text})

	local label = CreateLabel(holder, text)
	label.Size = UDim2.new(0, 150, 0, 20)
	local valLabel = CreateLabel(holder, tostring(default))
	valLabel.Size = UDim2.new(0, 40, 0, 20)
	valLabel.Position = UDim2.new(1, -40, 0, 0)
	valLabel.TextXAlignment = Enum.TextXAlignment.Right
	valLabel.TextColor3 = THEME.Accent
	RegisterAccent(valLabel, "TextColor3")

	local sliderBg = create("Frame", {
		Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 0, 30), BackgroundColor3 = THEME.ItemBG, BorderSizePixel = 0, Parent = holder
	})
	makeCorner(2, sliderBg)

	local fill = create("Frame", {
		Size = UDim2.new((default - min) / (max - min), 0, 1, 0), BackgroundColor3 = THEME.Accent, BorderSizePixel = 0, Parent = sliderBg
	})
	makeCorner(2, fill)
	RegisterAccent(fill, "BackgroundColor3")

	local interact = create("TextButton", {Text = "", Size = UDim2.new(1, 0, 1, 10), Position = UDim2.new(0, 0, 0, -5), BackgroundTransparency = 1, Parent = sliderBg})
	local draggingSlider = false
	interact.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = true end end)
	UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = false end end)
	UserInputService.InputChanged:Connect(function(input)
		if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
			local percent = math.clamp((UserInputService:GetMouseLocation().X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
			local value = math.floor(min + (max - min) * percent)
			tween(fill, {Size = UDim2.new(percent, 0, 1, 0)})
			valLabel.Text = tostring(value)
			if callback then callback(value) end
		end
	end)
end

