		Size = UDim2.new(0, 140, 0, 120), Position = UDim2.new(0, 0, 0, 30), BackgroundColor3 = Color3.fromRGB(255, 0, 0), BorderSizePixel = 0, Parent = holder
	})
	create("UIGradient", {Color = ColorSequence.new(Color3.new(1,1,1), Color3.new(1,1,1)), Parent = SV})
	create("Frame", {Size = UDim2.new(1,0,1,0), BackgroundColor3 = Color3.new(1,1,1), ZIndex = 2, Parent = SV, Name = "SatGrad"})
	create("UIGradient", {Color = ColorSequence.new(Color3.new(1,1,1), Color3.new(1,1,1)), Transparency = NumberSequence.new(0,1), Parent = SV.SatGrad})
	create("Frame", {Size = UDim2.new(1,0,1,0), BackgroundColor3 = Color3.new(0,0,0), ZIndex = 3, Parent = SV, Name = "ValGrad"})
	create("UIGradient", {Color = ColorSequence.new(Color3.new(0,0,0), Color3.new(0,0,0)), Transparency = NumberSequence.new(0,1), Rotation = -90, Parent = SV.ValGrad})

	local svKnob = create("Frame", {Size = UDim2.new(0, 8, 0, 8), BorderSizePixel = 0, BackgroundColor3 = Color3.new(1,1,1), ZIndex = 4, Parent = SV})
	makeCorner(4, svKnob)

	local Hue = create("Frame", {
		Size = UDim2.new(0, 20, 0, 120), Position = UDim2.new(0, 150, 0, 30), BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, Parent = holder
	})
	
	create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
		}), Parent = Hue
	})
	
	local hueKnob = create("Frame", {Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, Parent = Hue})

	local h, s, v = 0.5, 1, 1
	local draggingHue, draggingSV = false, false

	local function updateColor()
		local color = Color3.fromHSV(h, s, v)
		SV.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		UpdateTheme(color)
	end

	Hue.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingHue = true end end)
	SV.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSV = true end end)
	UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingHue = false draggingSV = false end end)
	
	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			if draggingHue then
				local y = math.clamp((input.Position.Y - Hue.AbsolutePosition.Y) / Hue.AbsoluteSize.Y, 0, 1)
				hueKnob.Position = UDim2.new(0, 0, y, 0)
				h = 1 - y
				updateColor()
			elseif draggingSV then
				local x = math.clamp((input.Position.X - SV.AbsolutePosition.X) / SV.AbsoluteSize.X, 0, 1)
				local y = math.clamp((input.Position.Y - SV.AbsolutePosition.Y) / SV.AbsoluteSize.Y, 0, 1)
				svKnob.Position = UDim2.new(x, -4, y, -4)
				s = x
				v = 1 - y
				updateColor()
			end
		end
	end)
	updateColor()
end

-- 5. Keybind System
local function AddKeybind(parent, text, defaultKey)
	local holder = CreateSection(parent, 40)
	table.insert(SearchRegistry, {Frame = holder, Text = text})
	
	local label = CreateLabel(holder, text)
	label.Size = UDim2.new(1, -100, 1, 0)
	
	local keyBtn = create("TextButton", {
		Text = "[" .. (defaultKey.Name) .. "]", Size = UDim2.new(0, 100, 0, 24), Position = UDim2.new(1, -105, 0.5, -12),
		BackgroundColor3 = THEME.ItemBG, TextColor3 = THEME.SubText, Font = Enum.Font.Gotham, TextSize = 13,
		AutoButtonColor = false, Parent = holder
	})
	makeCorner(4, keyBtn)
	
	local binding = false
	local currentKey = defaultKey
	
	keyBtn.MouseButton1Click:Connect(function()
		binding = true
		keyBtn.Text = "[...]"
		keyBtn.TextColor3 = THEME.Accent
	end)
	
	UserInputService.InputBegan:Connect(function(input)
		if binding then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				if input.KeyCode ~= Enum.KeyCode.Unknown then
					currentKey = input.KeyCode
					binding = false
					keyBtn.Text = "[" .. input.KeyCode.Name .. "]"
					keyBtn.TextColor3 = THEME.SubText
				end
			end
		elseif input.KeyCode == currentKey then
			ScreenGui.Enabled = not ScreenGui.Enabled
		end
	end)
end

