----------------------------------------------------------------

local Window = Library:CreateWindow()

--// 1. Fight Tab
local Fight = Window:Tab("Fight", Vector2.new(764, 244))
Fight:Toggle("Aimbot Enabled", true, function(state) print("Aimbot:", state) end)
Fight:Toggle("Silent Aim", false, function(state) print("Silent Aim:", state) end)
Fight:Dropdown("Aim Method", {"Camera", "Mouse", "Closest"}, "Camera", function(val) print(val) end)
Fight:Dropdown("Target Part", {"Head", "Torso", "HumanoidRootPart"}, "Head", function(val) print(val) end)
Fight:Slider("FOV Radius", 0, 500, 100, function(val) print(val) end)
Fight:Slider("Smoothing", 1, 20, 5, function(val) print(val) end)

--// 2. Movement Tab
local Move = Window:Tab("Movement", Vector2.new(4, 444))
Move:Toggle("Speed Hack", false, function(v) end)
Move:Slider("Speed Amount", 16, 200, 50, function(v) end)
Move:Toggle("Fly", false, function(v) end)
Move:Dropdown("Fly Mode", {"CFrame", "Velocity"}, "CFrame", function(v) end)

--// 3. Visuals Tab
local Vis = Window:Tab("Visuals", Vector2.new(4, 844))
Vis:Toggle("Enable ESP", false, function(v) end)
Vis:Toggle("Box ESP", false, function(v) end)
Vis:Toggle("Tracers", false, function(v) end)
Vis:Slider("Render Distance", 500, 5000, 1500, function(v) end)

--// 4. Config/Settings
Window:Tab("Settings", nil) -- Category Label
local Config = Window:Tab("Config", Vector2.new(444, 204))
Config:Keybind("Toggle UI Key", Enum.KeyCode.Insert)

local Theme = Window:Tab("Menu Accent", Vector2.new(244, 284))
Theme:ColorPicker()

print("Astro UI Loaded")
