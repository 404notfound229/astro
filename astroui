function Window:AddTab(name, iconRect)
    local Tab = {}
    Tab.Name = name
    
    local Page = create("ScrollingFrame", {
        Name = name.."Page", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, ScrollBarThickness = 2,
        ScrollBarImageColor3 = THEME.Accent, BorderSizePixel = 0, CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, Parent = self.ContentRegion
    })
    RegisterAccent(Page, "ScrollBarImageColor3")
    create("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = Page})
    create("UIPadding", {PaddingTop = UDim.new(0, 15), PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 15), PaddingBottom = UDim.new(0, 15), Parent = Page})
    
    self.Pages[name] = Page
    Tab.Page = Page
    
    local Btn = create("TextButton", {
        Name = name, Size = UDim2.new(1, -20, 0, 35), BackgroundTransparency = 1, 
        Text = "", AutoButtonColor = false, Parent = self.Sidebar
    })
    local BtnBG = create("Frame", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(30, 30, 30), 
        BackgroundTransparency = 1, Parent = Btn
    })
    makeCorner(4, BtnBG)
    local Icon = create("ImageLabel", {
        Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(0, 6, 0.5, -9), BackgroundTransparency = 1,
        Image = "rbxassetid://3926305904", ImageRectSize = Vector2.new(36, 36), 
        ImageRectOffset = iconRect or Vector2.new(0,0), ImageColor3 = THEME.SubText, Parent = Btn
    })
    local Label = create("TextLabel", {
        Text = name, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = THEME.SubText, 
        Size = UDim2.new(1, -30, 1, 0), Position = UDim2.new(0, 32, 0, 0), BackgroundTransparency = 1, 
        TextXAlignment = Enum.TextXAlignment.Left, Parent = Btn
    })
    
    self.Tabs[name] = {Btn = Btn, BG = BtnBG, Icon = Icon, Label = Label}
    
    local window = self
    Btn.MouseButton1Click:Connect(function()
        if ActiveDropdownCloseFunc then ActiveDropdownCloseFunc() ActiveDropdownCloseFunc = nil end
        if window.CurrentPage == name then return end
        
        if window.CurrentPage and window.Tabs[window.CurrentPage] then
            tween(window.Tabs[window.CurrentPage].BG, {BackgroundTransparency = 1})
            tween(window.Tabs[window.CurrentPage].Icon, {ImageColor3 = THEME.SubText})
            tween(window.Tabs[window.CurrentPage].Label, {TextColor3 = THEME.SubText})
            window.Pages[window.CurrentPage].Visible = false
        end
        
        window.CurrentPage = name
        tween(BtnBG, {BackgroundTransparency = 0.5})
        tween(Icon, {ImageColor3 = THEME.Accent})
        tween(Label, {TextColor3 = THEME.Text})
        Page.Visible = true
        Page.Position = UDim2.new(0, 15, 0, 0)
        tween(Page, {Position = UDim2.new(0,0,0,0)})
    end)
    
    if not window.CurrentPage then
        window.CurrentPage = name
        BtnBG.BackgroundTransparency = 0.5
        Icon.ImageColor3 = THEME.Accent
        Label.TextColor3 = THEME.Text
        Page.Visible = true
    end
    
    function Tab:AddToggle(config)
        local holder = create("Frame", {Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Parent = Page})
        table.insert(SearchRegistry, {Frame = holder, Text = config.Name})
        
        local label = create("TextLabel", {
            Text = config.Name, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = THEME.Text,
            Size = UDim2.new(1, -50, 1, 0), BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Parent = holder
        })
        
        local button = create("TextButton", {
            Text = "", Size = UDim2.new(0, 32, 0, 18), Position = UDim2.new(1, -35, 0.5, -9),
            BackgroundColor3 = config.Default and THEME.Accent or THEME.ToggleOff, AutoButtonColor = false, Parent = holder
        })
        makeCorner(9, button)
        if config.Default then RegisterAccent(button, "BackgroundColor3") end
        
        local circle = create("Frame", {
            Size = UDim2.new(0, 14, 0, 14), 
            Position = config.Default and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
            BackgroundColor3 = Color3.new(1,1,1), Parent = button
        })
        makeCorner(7, circle)
        
        local on = config.Default or false
        button.MouseButton1Click:Connect(function()
            on = not on
            if on then
                RegisterAccent(button, "BackgroundColor3")
                tween(button, {BackgroundColor3 = THEME.Accent})
                tween(circle, {Position = UDim2.new(1, -16, 0.5, -7)})
            else
                tween(button, {BackgroundColor3 = THEME.ToggleOff})
                tween(circle, {Position = UDim2.new(0, 2, 0.5, -7)})
            end
            if config.Callback then config.Callback(on) end
        end)
        
        return {
            Set = function(_, value)
                on = value
                if on then
                    button.BackgroundColor3 = THEME.Accent
                    circle.Position = UDim2.new(1, -16, 0.5, -7)
                else
                    button.BackgroundColor3 = THEME.ToggleOff
                    circle.Position = UDim2.new(0, 2, 0.5, -7)
                end
            end,
            Get = function() return on end
        }
    end
    
    function Tab:AddSlider(config)
        local holder = create("Frame", {Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, Parent = Page})
        table.insert(SearchRegistry, {Frame = holder, Text = config.Name})
        
        local label = create("TextLabel", {
            Text = config.Name, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = THEME.SubText,
            Size = UDim2.new(0, 150, 0, 20), BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Parent = holder
        })
        
        local valLabel = create("TextLabel", {
            Text = tostring(config.Default or config.Min), Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = THEME.Accent,
            Size = UDim2.new(0, 40, 0, 20), Position = UDim2.new(1, -40, 0, 0), BackgroundTransparency = 1, 
            TextXAlignment = Enum.TextXAlignment.Right, Parent = holder
        })
        RegisterAccent(valLabel, "TextColor3")
        
        local sliderBg = create("Frame", {
            Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 0, 30), 
            BackgroundColor3 = THEME.ItemBG, BorderSizePixel = 0, Parent = holder
        })
        makeCorner(2, sliderBg)
        
        local fill = create("Frame", {
            Size = UDim2.new(((config.Default or config.Min) - config.Min) / (config.Max - config.Min), 0, 1, 0), 
            BackgroundColor3 = THEME.Accent, BorderSizePixel = 0, Parent = sliderBg
        })
        makeCorner(2, fill)
        RegisterAccent(fill, "BackgroundColor3")
        
        local interact = create("TextButton", {
            Text = "", Size = UDim2.new(1, 0, 1, 10), Position = UDim2.new(0, 0, 0, -5), 
            BackgroundTransparency = 1, Parent = sliderBg
        })
        
        local dragging = false
        local currentValue = config.Default or config.Min
        
        interact.InputBegan:Connect(function(input) 
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end 
        end)
        UserInputService.InputEnded:Connect(function(input) 
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end 
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local percent = math.clamp((UserInputService:GetMouseLocation().X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
                currentValue = math.floor(config.Min + (config.Max - config.Min) * percent)
                tween(fill, {Size = UDim2.new(percent, 0, 1, 0)})
                valLabel.Text = tostring(currentValue)
                if config.Callback then config.Callback(currentValue) end
            end
        end)
        
        return {
            Set = function(_, value)
                currentValue = value
                local percent = (value - config.Min) / (config.Max - config.Min)
                fill.Size = UDim2.new(percent, 0, 1, 0)
                valLabel.Text = tostring(value)
            end,
            Get = function() return currentValue end
        }
    end
    
    function Tab:AddDropdown(config)
        local holder = create("Frame", {Size = UDim2.new(1, 0, 0, 45), BackgroundTransparency = 1, Parent = Page})
        table.insert(SearchRegistry, {Frame = holder, Text = config.Name})
        
        local label = create("TextLabel", {
            Text = config.Name, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = THEME.SubText,
            Size = UDim2.new(0, 100, 1, 0), BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Parent = holder
        })
        
        local mainBtn = create("TextButton", {
            Text = "", Size = UDim2.new(0, 140, 0, 26), Position = UDim2.new(1, -145, 0.5, -13),
            BackgroundColor3 = THEME.ItemBG, AutoButtonColor = false, Parent = holder
        })
        makeCorner(4, mainBtn)
        
        local selectedText = create("TextLabel", {
            Text = config.Default or config.Options[1], Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = THEME.Text,
            Size = UDim2.new(1, -30, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = mainBtn
        })
        
        local arrow = create("ImageLabel", {
            Image = "rbxassetid://6034818372", Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(1, -20, 0.5, -6),
            BackgroundTransparency = 1, ImageColor3 = THEME.SubText, Parent = mainBtn
        })
        
        local listContainer = create("Frame", {
            Size = UDim2.new(0, 140, 0, 0), BackgroundColor3 = THEME.ItemBG, 
            BorderSizePixel = 0, ClipsDescendants = true, Visible = false, Parent = window.DropdownLayer
        })
        makeCorner(4, listContainer)
        create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2), Parent = listContainer})
        create("UIPadding", {PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = listContainer})
        
        local isOpen = false
        local renderStep
        local selected = config.Default or config.Options[1]
        
        local function closeDropdown()
            isOpen = false
            if renderStep then renderStep:Disconnect() renderStep = nil end
            tween(arrow, {Rotation = 0})
            tween(listContainer, {Size = UDim2.new(0, 140, 0, 0)})
            task.wait(0.25)
            if not isOpen then listContainer.Visible = false end
            if ActiveDropdownCloseFunc == closeDropdown then ActiveDropdownCloseFunc = nil end
        end
        
        mainBtn.MouseButton1Click:Connect(function()
            if isOpen then
                closeDropdown()
            else
                if ActiveDropdownCloseFunc then ActiveDropdownCloseFunc() end
                isOpen = true
                ActiveDropdownCloseFunc = closeDropdown
                listContainer.Visible = true
                tween(arrow, {Rotation = 180})
                tween(listContainer, {Size = UDim2.new(0, 140, 0, math.min(#config.Options * 24 + 10, 150))})
                renderStep = RunService.RenderStepped:Connect(function()
                    if not mainBtn or not mainBtn.Parent then closeDropdown() return end
                    local btnAbsPos = mainBtn.AbsolutePosition
                    local layerAbsPos = window.DropdownLayer.AbsolutePosition
                    listContainer.Position = UDim2.new(0, btnAbsPos.X - layerAbsPos.X, 0, (btnAbsPos.Y - layerAbsPos.Y) + 30)
                end)
            end
        end)
        
        for _, opt in ipairs(config.Options) do
            local optBtn = create("TextButton", {
                Text = "  " .. opt, Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1,
                TextColor3 = THEME.SubText, Font = Enum.Font.Gotham, TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 110, Parent = listContainer
            })
            optBtn.MouseButton1Click:Connect(function()
                selected = opt
                selectedText.Text = opt
                closeDropdown()
                if config.Callback then config.Callback(opt) end
            end)
            optBtn.MouseEnter:Connect(function() optBtn.BackgroundColor3 = THEME.Accent optBtn.BackgroundTransparency = 0.85 end)
            optBtn.MouseLeave:Connect(function() optBtn.BackgroundTransparency = 1 end)
        end
        
        return {
            Set = function(_, value)
                selected = value
                selectedText.Text = value
            end,
            Get = function() return selected end
        }
    end
    
    function Tab:AddKeybind(config)
        local holder = create("Frame", {Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Parent = Page})
        table.insert(SearchRegistry, {Frame = holder, Text = config.Name})
        
        local label = create("TextLabel", {
            Text = config.Name, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = THEME.SubText,
            Size = UDim2.new(1, -100, 1, 0), BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Parent = holder
        })
        
        local keyBtn = create("TextButton", {
            Text = "[" .. config.Default.Name .. "]", Size = UDim2.new(0, 100, 0, 24), Position = UDim2.new(1, -105, 0.5, -12),
            BackgroundColor3 = THEME.ItemBG, TextColor3 = THEME.SubText, Font = Enum.Font.Gotham, TextSize = 13,
            AutoButtonColor = false, Parent = holder
        })
        makeCorner(4, keyBtn)
        
        local binding = false
        local currentKey = config.Default
        
        keyBtn.MouseButton1Click:Connect(function()
            binding = true
            keyBtn.Text = "[...]"
            keyBtn.TextColor3 = THEME.Accent
        end)
        
        UserInputService.InputBegan:Connect(function(input)
            if binding then
                if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
                    currentKey = input.KeyCode
                    binding = false
                    keyBtn.Text = "[" .. input.KeyCode.Name .. "]"
                    keyBtn.TextColor3 = THEME.SubText
                    if config.Callback then config.Callback(currentKey) end
                end
            elseif input.KeyCode == currentKey and config.OnPress then
                config.OnPress()
            end
        end)
        
        return {
            Set = function(_, key)
                currentKey = key
                keyBtn.Text = "[" .. key.Name .. "]"
            end,
            Get = function() return currentKey end
        }
    end
    
